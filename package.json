{
  "name": "1stg",
  "version": "0.0.0",
  "type": "module",
  "description": "Server Rendered Static Homepage Website powered by Technology Stack Of React",
  "repository": "git@github.com:JounQin/1stg.git",
  "author": "JounQin <admin@1stg.me>",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rimraf dist && vite build --ssr src/entry-server.tsx && vite build",
    "dev": "vite",
    "lint": "run-p \"lint:*\"",
    "lint:es": "eslint . --cache",
    "lint:style": "stylelint 'src/**/*.scss' --cache",
    "lint:ts": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "prepare": "simple-git-hooks",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@1stg/app-config": "^15.0.0",
    "@1stg/nano-staged": "^0.3.1",
    "@1stg/simple-git-hooks": "^2.1.0",
    "@1stg/tsconfig": "^4.0.0",
    "@commitlint/cli": "^21.0.0",
    "@eslint-react/eslint-plugin": "^5.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "cssnano": "^9.3.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nano-staged": "^1.0.2",
    "normalize.css": "^8.0.1",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.6",
    "postcss-plugin-px2rem": "^0.8.1",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.105.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0"
  }
}
