{
  "name": "1stg",
  "version": "0.0.0",
  "description": "Server Rendered Static Homepage Website powered by Technology Stack Of React",
  "repository": "git@github.com:JounQin/1stg.git",
  "author": "JounQin <admin@1stg.me>",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "rimraf dist && cross-env \"DEBUG=1stg:*\" NODE_ENV=production NODE_OPTIONS=--openssl-legacy-provider run-p \"build:**\"",
    "build-static": "sh build/static.sh",
    "build:react:client": "webpack --config=build/react.client.babel.js --colors --progress",
    "build:react:server": "webpack --config=build/react.server.babel.js --colors --progress",
    "build:server": "webpack --config build/server.babel.js --colors --progress",
    "build:template": "node build/template.js",
    "dev": "cross-env \"DEBUG=1stg:*\" babel-node server",
    "lint": "run-p \"lint:*\"",
    "lint:es": "eslint . --cache",
    "lint:style": "stylelint 'src/**/*.scss' --cache",
    "prepare": "simple-git-hooks",
    "start": "cross-env \"DEBUG=1stg:*\" node dist/server"
  },
  "dependencies": {
    "anujs": "^1.6.0",
    "core-js": "^3.33.2",
    "cross-env": "^7.0.3",
    "debug": "^4.3.4",
    "koa": "^2.14.2",
    "koa-compose": "^4.1.0",
    "koa-compress": "^3.1.0",
    "koa-logger": "^3.2.1",
    "koa-static-cache": "^5.1.2",
    "memory-fs": "^0.5.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-server-renderer": "^1.2.0"
  },
  "devDependencies": {
    "@1stg/app-config": "^15.0.0",
    "@1stg/nano-staged": "^0.3.1",
    "@1stg/simple-git-hooks": "^2.1.0",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/eslint-plugin": "^7.29.7",
    "@babel/node": "^7.8.4",
    "@babel/register": "^7.8.3",
    "@commitlint/cli": "^21.0.0",
    "@hot-loader/react-dom": "^16.14.0",
    "babel-loader": "^8.3.0",
    "css-loader": "^3.6.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "file-loader": "^6.2.0",
    "friendly-errors-webpack-plugin": "^1.7.0",
    "globals": "^17.13.0",
    "html-minifier": "^4.0.0",
    "img-loader": "^3.0.1",
    "koa-webpack": "^5.3.0",
    "mini-css-extract-plugin": "^0.9.0",
    "nano-staged": "^0.8.0",
    "normalize.css": "^8.0.1",
    "npm-run-all2": "^5.0.0",
    "postcss-loader": "^4.3.0",
    "postcss-plugin-px2rem": "^0.8.1",
    "prettier": "^3.0.0",
    "prop-types": "^15.7.2",
    "pug": "^3.0.0",
    "pug-plain-loader": "^1.0.0",
    "react-hot-loader": "^4.13.1",
    "react-style-loader": "^2.3.0",
    "rimraf": "^3.0.2",
    "sass": "^1.69.5",
    "sass-loader": "^8.0.2",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "sw-precache-webpack-plugin": "^1.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12",
    "webpack-merge": "^4.2.2",
    "webpack-node-externals": "^1.7.2"
  },
  "resolutions": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.4",
    "imagemin-gifsicle": "^6.0.1"
  }
}
