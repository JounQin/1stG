{
  "name": "1stg",
  "version": "0.0.0",
  "description": "Server Rendered Static Homepage Website powered by Technology Stack Of React",
  "repository": "git@github.com:JounQin/1stg.git",
  "author": "JounQin <admin@1stg.me>",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "rimraf dist && vite build && vite build --ssr src/entry-server.tsx",
    "build-static": "sh build/static.sh",
    "dev": "vite",
    "lint": "run-p \"lint:*\"",
    "lint:es": "eslint . --cache",
    "lint:style": "stylelint 'src/**/*.scss' --cache",
    "lint:ts": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@1stg/app-config": "^15.0.0",
    "@1stg/nano-staged": "^0.3.1",
    "@1stg/simple-git-hooks": "^2.1.0",
    "@1stg/tsconfig": "^4.0.0",
    "@commitlint/cli": "^21.0.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "nano-staged": "^0.8.0",
    "normalize.css": "^8.0.1",
    "npm-run-all2": "^5.0.0",
    "postcss": "^8.5.6",
    "postcss-plugin-px2rem": "^0.8.1",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.93.2",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3"
  },
  "resolutions": {
    "@eslint/js": "^9.39.4"
  }
}
